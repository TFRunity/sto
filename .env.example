# Скопировать в .env и заменить значения (ADR-011, I-04). .env в git не попадает.
# Пароли без символов @ : / ? # — они подставляются в DATABASE_URL и RABBITMQ_URL как есть.

LOG_LEVEL=info

# JWT HS256 — 32+ случайных байт, общий у Users и Gateway (ADR-023).
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-32-plus-random-bytes-xxxxxxxxxxxx
JWT_TTL=168h

# Seed сотрудников (users/migrations/00002_seed_staff.sql): телефоны +70000000001 (engineer),
# +70000000002 (director). Пароль открытым текстом — только для scripts/e2e.sh.
# Хеш — bcrypt cost 12; ОДИНАРНЫЕ кавычки обязательны: без них compose и шелл
# раскроют $2a$12$… как переменные.
SEED_ENGINEER_PASSWORD=engineer-example
SEED_ENGINEER_PASSWORD_HASH='$2a$12$qAJXPLpS2.wK90iasDQaf.mlscXSYUk2AknPRo63TeXaUfcKX1Xmm'
SEED_DIRECTOR_PASSWORD=director-example
SEED_DIRECTOR_PASSWORD_HASH='$2a$12$dP3p4SHnXrkTcUStqAb2P.BwbtIIi/Svkp1tu/oBYDrksti3RH4HS'

USERS_DB_USER=users
USERS_DB_PASSWORD=change-me-users

ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=change-me-orders

INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=change-me-inventory

# неделя 2
VEHICLE_DB_USER=vehicle
VEHICLE_DB_PASSWORD=change-me-vehicle
SERVICES_DB_USER=services
SERVICES_DB_PASSWORD=change-me-services

RABBITMQ_USER=sto
RABBITMQ_PASSWORD=change-me-rabbit
