  <diagram id="saga" name="Оплата и дедлайн">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1020">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Оплата и дедлайн" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontSize=32;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1360" height="48" />
        </mxCell>
        <mxCell id="subtitle" value="Две конкурирующие ветки в Orders. Обе меняют шаг саги условным UPDATE в PostgreSQL." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="78" width="1360" height="40" />
        </mxCell>
        <mxCell id="start" value="Клиент · POST /orders/{id}/pay&#10;PayOrder → saga.Service.StartPayment" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;spacing=8;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="495" y="136" width="450" height="67" />
        </mxCell>
        <mxCell id="tx" value="Orders · транзакция&#10;active → paid · saga verifying_stock · DeductStock в outbox&#10;После коммита клиент получает 202" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#a16207;strokeWidth=2;spacing=8;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="455" y="250" width="530" height="88" />
        </mxCell>
        <mxCell id="send" value="Orders outbox → RabbitMQ&#10;saga_commands / inventory.saga_commands" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;spacing=8;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="470" y="393" width="500" height="70" />
        </mxCell>
        <mxCell id="stock" value="Inventory · handle → apply → decide → applyCommand&#10;В транзакции: попытка по saga_id · остаток · ответ в outbox" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;spacing=8;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="514" width="590" height="84" />
        </mxCell>
        <mxCell id="reply" value="Inventory outbox → RabbitMQ&#10;saga_replies / orders.saga_replies" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;spacing=8;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="435" y="650" width="500" height="73" />
        </mxCell>
        <mxCell id="consume" value="Orders · HandleReply → applyReply&#10;До дедлайна: StockDeducted → completed + запись справки&#10;StockRejected → failed + заказ active" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;spacing=8;fontSize=15;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="435" y="786" width="500" height="105" />
        </mxCell>
        <mxCell id="timer" value="Orders · RunDeadlines&#10;expireDue → expire" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=2;spacing=8;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="520" width="300" height="78" />
        </mxCell>
        <mxCell id="expire" value="Orders · транзакция по дедлайну&#10;failed · заказ active&#10;CancelStock в outbox" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=2;spacing=8;fontSize=15;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="780" width="300" height="105" />
        </mxCell>
        <mxCell id="cancel" value="Доставка CancelStock&#10;Orders outbox → RabbitMQ → Inventory&#10;Возврат товара или запись отмены" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;spacing=8;fontSize=15;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1035" y="780" width="365" height="105" />
        </mxCell>
        <mxCell id="start-tx" value="HTTP-обработчик" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563eb;fontFamily=Arial;fontSize=13;fontColor=#0f172a;labelBackgroundColor=#ffffff;" edge="1" source="start" target="tx" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="tx-send" value="после коммита" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9333ea;fontFamily=Arial;fontSize=13;fontColor=#0f172a;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="tx" target="send" parent="1">
