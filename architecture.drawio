        </mxCell>
        <mxCell id="subtitle" value="Один путь подробно · инженер добавляет товар через POST /api/orders/{id}/items." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="78" width="1360" height="40" />
        </mxCell>
        <mxCell id="gateway" value="Периметр · Gateway&#10;NewRouter → handleRequest → authorizeRequest → ReverseProxy" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;spacing=8;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="140" width="720" height="78" />
        </mxCell>
        <mxCell id="validation" value="Вход Orders · HTTP и контракт&#10;chassis/httpx.Validator → сгенерированный strict-сервер → readIdentity" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;spacing=8;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="265" width="720" height="78" />
        </mxCell>
        <mxCell id="handler" value="HTTP-адаптер · orders/internal/order&#10;AddOrderItem → itemPrice → inventoryClient.lookup" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;spacing=8;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="395" width="720" height="84" />
        </mxCell>
        <mxCell id="inventory" value="Inventory · HTTP&#10;GetItem → repository.get → sqlc → PostgreSQL" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;spacing=8;fontSize=15;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
