          <mxGeometry as="geometry" x="360" y="555" width="720" height="76" />
        </mxCell>
        <mxCell id="sql" value="Хранилище&#10;queries/orders.sql → sqlc → pgx → PostgreSQL · order_items" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#a16207;strokeWidth=2;spacing=8;fontSize=16;fontFamily=Arial;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="690" width="720" height="80" />
        </mxCell>
