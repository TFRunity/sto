        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;━━ ассоциация внутри сервиса (FK в одной БД)&lt;br&gt;&lt;font color='#3c5a8a'&gt;━━ &lt;b&gt;синяя&lt;/b&gt; — ссылка между сервисами: uuid по соглашению, без FK (ADR-001, ADR-007)&lt;/font&gt;&lt;br&gt;◆━ композиция: часть живёт и умирает с целым&lt;br&gt;━▷ обобщение (наследование)&lt;br&gt;╌╌&amp;gt; зависимость: использует / шлёт асинхронную команду&lt;br&gt;┄┄ пунктир с точками — связь с несуществующим модулем (TODO)&lt;br&gt;&lt;font color='#888888'&gt;&lt;i&gt;серый курсив&lt;/i&gt;&lt;/font&gt; — пояснение из sequence/ADR, не часть модели&lt;br&gt;&lt;font color='#b85450'&gt;&lt;b&gt;⚠&lt;/b&gt;&lt;/font&gt; — открытый вопрос (TODO §4), см. внизу" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="2270" y="1420" width="410" height="210" as="geometry" />
        </mxCell>
        <mxCell id="issues" value="&lt;b&gt;Принятые решения&lt;/b&gt; (08.10.2026)&lt;br&gt;• &lt;b&gt;Статусы заказа:&lt;/b&gt; requested → active → paid / cancelled; &lt;b&gt;paid — финал&lt;/b&gt;, статуса completed нет (ADR-021).&lt;br&gt;• &lt;b&gt;Этап работ&lt;/b&gt; (принят / в_работе / готов / выдан) — отдельное поле заказа, меняет инженер; «выдан» только при paid. Статуса у ТС нет (ADR-021).&lt;br&gt;• &lt;b&gt;Инженеры заказа:&lt;/b&gt; orders.engineer_id — ответственный (claim, ADR-017); order_engineers — все исполнители. Claim = UPDATE + INSERT в одной транзакции (ADR-020). Список инженера строится по ответственному. В текущем заказе до выдачи ответственный видит историю этого ТС.&lt;br&gt;• &lt;b&gt;Роли:&lt;/b&gt; client (через /register) / engineer / director (вручную в БД); Gateway проверяет роль по эндпоинтам (ADR-019).&lt;br&gt;• &lt;b&gt;Владелец ТС:&lt;/b&gt; vehicles.owner_id (client, без FK); новый use case клиента «Добавить ТС»; инженер проставляет владельца при создании карточки.&lt;br&gt;• &lt;b&gt;Оплата&lt;/b&gt; — только клиент в вебе; в RN вместо кнопки индикатор «Ожидает оплаты клиентом».&lt;br&gt;• &lt;b&gt;v1 / v2 (19.10.2026):&lt;/b&gt; Chat и Reports (+ «Статистика по сотрудникам») вынесены в v2 — см. v2/. Сага оплаты, outbox и RabbitMQ остаются в v1 полностью.&lt;br&gt;• &lt;b&gt;Справка:&lt;/b&gt; active → completed / failed (опечатка «created» убрана).&lt;br&gt;• &lt;b&gt;Use case:&lt;/b&gt; добавить «Взять заявку в работу» (инженер); убрать линию «Записаться → Оплатить», связать Клиент → «Оплатить заказ».&lt;br&gt;&lt;br&gt;&lt;font color='#b85450'&gt;&lt;b&gt;⚠ Открыто:&lt;/b&gt;&lt;/font&gt; модуль коммерческих операций (TODO §4) — платёж, шлюз, возврат денег. «Выручка» (карточка дашборда директора) пока = сумма paid-заказов.&lt;br&gt;&lt;br&gt;&lt;b&gt;Решения 30.10.2026&lt;/b&gt; (ADR-022…038, ⚠ — авторешения, см. CHANGES-v1.md)&lt;br&gt;• &lt;b&gt;Сага оплаты:&lt;/b&gt; ключ saga_id, дедлайн 10 с, воркер дедлайнов, CancelStock; Inventory ведёт stock_attempts (deducted / rejected / cancelled) — ADR-030.&lt;br&gt;• &lt;b&gt;Переходы состояний&lt;/b&gt; — условный UPDATE WHERE &amp;lt;состояние&amp;gt; = &amp;lt;ожидаемое&amp;gt; (кроме claim) — ADR-031.&lt;br&gt;• &lt;b&gt;«Выдан» и справка&lt;/b&gt; — только при paid и успешно завершённой саге (D-09).&lt;br&gt;• &lt;b&gt;Справка:&lt;/b&gt; pending → completed / failed, attempts ≤ 3, пауза 10 с → 1 мин, всё собирает воркер — ADR-035.&lt;br&gt;• &lt;b&gt;Цена&lt;/b&gt; фиксируется в order_items / order_services при добавлении позиции — ADR-034.&lt;br&gt;• &lt;b&gt;Soft delete:&lt;/b&gt; deleted_at; уникальность номера ТС и телефона — только среди живых — ADR-033.&lt;br&gt;• &lt;b&gt;Остаток:&lt;/b&gt; списание WHERE quantity &gt;= N, CHECK (quantity &gt;= 0)." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="20" y="1840" width="1790" height="400" as="geometry" />
        </mxCell>
        <mxCell id="attempt" value="ПопыткаСписания (stock_attempts)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1880" y="1050" width="320" height="132.0" as="geometry" />
        </mxCell>
        <mxCell id="attempt_a" value="+uuid saga_id &lt;font color=&quot;#888888&quot;&gt;&lt;i&gt;PK, ключ идемпотентности&lt;/i&gt;&lt;/font&gt;&lt;br&gt;+uuid order_id &lt;font color=&quot;#888888&quot;&gt;&lt;i&gt;для логов&lt;/i&gt;&lt;/font&gt;&lt;br&gt;+СостояниеПопытки состояние&lt;br&gt;+datetime created_at / updated_at" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=12;" parent="attempt" vertex="1">
          <mxGeometry x="0" y="26" width="320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="attempt_l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" parent="attempt" vertex="1">
          <mxGeometry x="0" y="102.0" width="320" height="8" as="geometry" />
        </mxCell>
        <mxCell id="attempt_o" value="+применить(команда) &lt;font color=&quot;#888888&quot;&gt;&lt;i&gt;decide(): ADR-030&lt;/i&gt;&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=12;" parent="attempt" vertex="1">
          <mxGeometry x="0" y="110.0" width="320" height="22" as="geometry" />
        </mxCell>
        <mxCell id="attitem" value="ПозицияСписания (stock_attempt_items)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1880" y="1210" width="320" height="84.0" as="geometry" />
        </mxCell>
        <mxCell id="attitem_a" value="+uuid saga_id&lt;br&gt;+uuid item_id&lt;br&gt;+int количество &lt;font color=&quot;#888888&quot;&gt;&lt;i&gt;источник для возврата&lt;/i&gt;&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=12;" parent="attitem" vertex="1">
          <mxGeometry x="0" y="26" width="320" height="58" as="geometry" />
        </mxCell>
        <mxCell id="astat" value="«enumeration»&lt;br&gt;&lt;b&gt;СостояниеПопытки&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1880" y="1320" width="220" height="98" as="geometry" />
        </mxCell>
        <mxCell id="astat_a" value="deducted&lt;br&gt;rejected&lt;br&gt;cancelled &lt;font color=&quot;#888888&quot;&gt;&lt;i&gt;в т.ч. tombstone&lt;/i&gt;&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=12;" parent="astat" vertex="1">
          <mxGeometry x="0" y="40" width="220" height="58" as="geometry" />
        </mxCell>
        <mxCell id="e30" value="" style="html=1;rounded=0;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;strokeColor=#333333;" parent="1" source="attempt" target="attitem" edge="1">
          <mxGeometry relative="1" as="geometry" />
