idth="10" x="678" y="232" as="geometry" /></mxCell><mxCell id="m5" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;whiteSpace=nowrap;" value="5. Для выдачи UPDATE требует status='paid'&lt;br&gt;и попытку списания в completed" vertex="1"><mxGeometry height="20" width="10" x="678" y="306" as="geometry" /></mxCell><mxCell id="m6" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=11;align=center;verticalAlign=bottom;" value="6. 200 OK"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="360" as="sourcePoint" /><mxPoint x="400" y="360" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=11;align=center;verticalAlign=bottom;" value="7. 200 OK — бейдж обновлён"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="404" as="sourcePoint" /><mxPoint x="130" y="404" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=11;align=center;verticalAlign=bottom;" value="5'. 409 order_not_paid"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="478" as="sourcePoint" /><mxPoint x="400" y="478" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m9" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=11;align=center;verticalAlign=bottom;" value="6'. 409 → Android перечитывает карточку"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="522" as="sourcePoint" /><mxPoint x="130" y="522" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note1" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;size=10;" value="Android показывает действие выдачи после оплаты&lt;br&gt;и списания. Отметка оплаты сама по себе&lt;br&gt;не открывает выдачу, а сервер проверяет&lt;br&gt;готовность при обновлении этапа (ADR-043)." vertex="1"><mxGeometry height="88" width="260" x="700" y="100" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>