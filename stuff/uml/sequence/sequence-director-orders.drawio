            <mxPoint x="300" y="190" as="sourcePoint" />
            <mxPoint x="520" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="3. GET /internal/vehicles/search?q= (номер, нормализованный)">
