            <mxPoint x="740" y="300" as="sourcePoint" />
            <mxPoint x="300" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a8" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=nowrap;" value="6. оба списка пусты → сразу 200 (пустая страница), в Orders не идём" vertex="1">
          <mxGeometry x="308" y="320" width="10" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m9" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="7. GET /internal/orders?status=&amp;client_ids=&amp;vehicle_ids=&amp;page=">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="410" as="sourcePoint" />
            <mxPoint x="960" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a10" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=nowrap;" value="8. SELECT … фильтр status&lt;br&gt;AND (client_id = ANY($1)&lt;br&gt;OR vehicle_id = ANY($2))&lt;br&gt;ORDER BY created_at DESC&lt;br&gt;LIMIT / OFFSET" vertex="1">
          <mxGeometry x="968" y="425" width="10" height="76" as="geometry" />
        </mxCell>
        <mxCell id="m11" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=10;align=center;verticalAlign=bottom;" value="9. 200 OK (страница заказов: ID, статус, этап и сумма)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="510" as="sourcePoint" />
            <mxPoint x="300" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="10. GET /users?ids= (клиенты + инженеры)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="575" as="sourcePoint" />
            <mxPoint x="520" y="575" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="11. GET /internal/vehicles?ids= (номера ТС)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="610" as="sourcePoint" />
            <mxPoint x="740" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m14" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=10;align=center;verticalAlign=bottom;" value="12. имена (вкл. удалённых)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="640" as="sourcePoint" />
            <mxPoint x="300" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m15" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=10;align=center;verticalAlign=bottom;" value="13. номера">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="660" as="sourcePoint" />
            <mxPoint x="300" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m16" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=10;align=center;verticalAlign=bottom;" value="14. 200 OK — таблица (director-web-design.md)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="710" as="sourcePoint" />
            <mxPoint x="90" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note17" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;size=10;" value="Gateway — оркестратор, без бизнес-правил: склеивает данные трёх сервисов.&lt;br&gt;Любой отказ или дедлайн 3 с → 502 / 504, частичного ответа нет —&lt;br&gt;как в дашборде (ADR-032). Пагинация — в Orders, после фильтра по id" vertex="1">
          <mxGeometry x="40" y="740" width="560" height="76" as="geometry" />
        </mxCell>
        <mxCell id="note18" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;size=10;" value="Параметры (А-12, принято пока): q от 2 символов, ILIKE по подстроке;&lt;br&gt;до 200 id от каждого сервиса, больше — 422 «уточните запрос»;&lt;br&gt;поиск и пакет по id включают удалённых (-- include-deleted)" vertex="1">
          <mxGeometry x="620" y="740" width="480" height="76" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
