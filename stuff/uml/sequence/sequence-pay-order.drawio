            <mxPoint x="990" y="80" as="sourcePoint" />
            <mxPoint x="990" y="1360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m15" edge="1" parent="1" style="html=1;endArrow=block;fontSize=11;align=center;verticalAlign=bottom;" value="1. POST /orders/{id}/pay (через Gateway)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="120" as="sourcePoint" />
            <mxPoint x="300" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a16" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=nowrap;" value="2. Идентификатор клиента из Gateway" vertex="1">
          <mxGeometry x="308" y="170" width="10" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m17" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="3. UPDATE orders SET status='paid', paid_at=now()&lt;br&gt;WHERE id=? AND client_id=? AND status='active'">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="228" as="sourcePoint" />
            <mxPoint x="530" y="228" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m18" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="4. INSERT saga_state: 'verifying_stock',&lt;br&gt;deadline = infinity (v3)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="276" as="sourcePoint" />
            <mxPoint x="530" y="276" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m19" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="5. INSERT outbox: DeductStock&lt;br&gt;{saga_id, order_id, items[item_id, qty]}">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="324" as="sourcePoint" />
            <mxPoint x="530" y="324" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note20" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;size=10;" value="Шаги 3–5 выполняются в одной транзакции (ADR-043).&lt;br&gt;Если UPDATE не изменил строку, читаем paid_at&amp;nbsp;владельца.&lt;br&gt;Нашли → 200 с исходным временем, без новой попытки.&lt;br&gt;Иначе → 409 order_not_active." vertex="1">
          <mxGeometry x="660" y="150" width="385" height="84" as="geometry" />
        </mxCell>
        <mxCell id="m21" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=10;align=center;verticalAlign=bottom;" value="6. 200 OK: paid и paid_at">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="372" as="sourcePoint" />
            <mxPoint x="90" y="372" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m22" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="7. outbox-воркер (тик ~1 с): publish,&lt;br&gt;MessageId = outbox.id, published — по confirm">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="424" as="sourcePoint" />
            <mxPoint x="760" y="424" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m23" edge="1" parent="1" style="html=1;endArrow=open;endSize=10;fontSize=11;align=center;verticalAlign=bottom;" value="8. DeductStock (saga_id)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="470" as="sourcePoint" />
            <mxPoint x="990" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a24" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=nowrap;" value="9. decide(попытка по saga_id, DeductStock) — чистая функция (ADR-031)" vertex="1">
          <mxGeometry x="998" y="485" width="10" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a25" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=nowrap;" value="10. tx: по каждой позиции UPDATE inventory SET quantity = quantity − N&lt;br&gt;WHERE id=? AND quantity &gt;= N;&lt;br&gt;все прошли → INSERT stock_attempts 'deducted' + позиции + outbox StockDeducted;&lt;br&gt;иначе ROLLBACK → INSERT 'rejected' + outbox StockRejected" vertex="1">
          <mxGeometry x="998" y="558" width="10" height="62" as="geometry" />
        </mxCell>
        <mxCell id="a26" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=nowrap;" value="11. outbox: тот же ответ ещё раз (не молчаливый ack)" vertex="1">
          <mxGeometry x="998" y="668" width="10" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a27" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=nowrap;" value="12. outbox: StockRejected — команда после отмены отклонена" vertex="1">
          <mxGeometry x="998" y="730" width="10" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a28" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=nowrap;" value="13. ack после коммита (ADR-025)" vertex="1">
          <mxGeometry x="998" y="775" width="10" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m29" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=10;align=center;verticalAlign=bottom;" value="14. outbox-воркер Inventory:&lt;br&gt;StockDeducted | StockRejected (saga_id)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="832" as="sourcePoint" />
            <mxPoint x="760" y="832" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m30" edge="1" parent="1" style="html=1;endArrow=open;endSize=10;fontSize=10;align=center;verticalAlign=bottom;" value="15. очередь orders.saga_replies">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="868" as="sourcePoint" />
            <mxPoint x="300" y="868" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m31" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="16. tx: попытка → completed условно;&lt;br&gt;для v1 записать paid_at; поставить справку в очередь">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="945" as="sourcePoint" />
            <mxPoint x="530" y="945" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m32" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="17. tx: попытка → failed условно;&lt;br&gt;v3 остаётся paid, только v1 возвращается в active">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="1018" as="sourcePoint" />
            <mxPoint x="530" y="1018" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a33" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=nowrap;" value="18. ack + warn-лог, ничего не менять" vertex="1">
          <mxGeometry x="308" y="1060" width="10" height="20" as="geometry" />
        </mxCell>
        <mxCell id="note34" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;size=10;" value="У новой попытки v3 нет срока истечения.&lt;br&gt;Если Inventory недоступен, заказ остаётся paid,&lt;br&gt;а списание — pending до ответа." vertex="1">
          <mxGeometry x="1000" y="890" width="470" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m35" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="19. SELECT saga_state WHERE current_step='verifying_stock'&lt;br&gt;AND deadline &lt; now()">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="1170" as="sourcePoint" />
            <mxPoint x="530" y="1170" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m36" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="20. tx: сага → 'failed' (условно), orders paid → active,&lt;br&gt;outbox CancelStock {saga_id}">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="1225" as="sourcePoint" />
            <mxPoint x="530" y="1225" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m37" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="21. publish CancelStock">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="1265" as="sourcePoint" />
            <mxPoint x="760" y="1265" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m38" edge="1" parent="1" style="html=1;endArrow=open;endSize=10;fontSize=10;align=center;verticalAlign=bottom;" value="22. CancelStock (saga_id)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="1295" as="sourcePoint" />
            <mxPoint x="990" y="1295" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a39" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=nowrap;" value="23. deducted → вернуть позиции, 'cancelled'; попытки нет → tombstone 'cancelled';&lt;br&gt;rejected / cancelled → ничего. Ответ на отмену не нужен" vertex="1">
          <mxGeometry x="998" y="1305" width="10" height="34" as="geometry" />
        </mxCell>
        <mxCell id="note40" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#a32d2d;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;size=10;" value="Веб показывает подтверждение из ответа 200.&lt;br&gt;Списание и этап выдачи обновляются при чтении заказа." vertex="1">
          <mxGeometry x="40" y="1375" width="470" height="62" as="geometry" />
        </mxCell>
        <mxCell id="note41" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;size=10;" value="Повтор списания в v3 после отказа склада и пополнения остатков&lt;br&gt;Инженер → Gateway → Orders: POST /orders/{id}/stock/retry.&lt;br&gt;Orders блокирует заказ и проверяет, что есть отказ и нет ожидающей или успешной попытки.&lt;br&gt;Если повтор допустим, Orders пишет DeductStock с новым saga_id и отвечает 202.&lt;br&gt;Иначе отвечает 409 stock_retry_unavailable. Дубликат доставки сохраняет прежний saga_id." vertex="1">
          <mxGeometry x="530" y="1375" width="760" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
