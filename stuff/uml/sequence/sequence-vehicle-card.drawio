<mxfile host="Electron">
  <diagram name="Sequence - Карточка ТС" id="seq-vehicle-card">
    <mxGraphModel dx="808" dy="481" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p_client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" value="Клиент (веб)" vertex="1">
          <mxGeometry height="40" width="140" x="60" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p_gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1efe8;strokeColor=#888780;fontSize=13;fontStyle=1;" value="API Gateway" vertex="1">
          <mxGeometry height="40" width="140" x="330" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p_vehicle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f1fb;strokeColor=#378add;fontSize=13;fontStyle=1;" value="Vehicle service" vertex="1">
          <mxGeometry height="40" width="140" x="600" y="40" as="geometry" />
        </mxCell>
        <mxCell id="ll1" edge="1" parent="1" source="p_client" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="80" as="sourcePoint" />
            <mxPoint x="130" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll2" edge="1" parent="1" source="p_gateway" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="80" as="sourcePoint" />
            <mxPoint x="400" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll3" edge="1" parent="1" source="p_vehicle" style="endArrow=none;dashed=1;html=1;strokeColor=#378add;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="80" as="sourcePoint" />
            <mxPoint x="670" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1" edge="1" parent="1" style="html=1;endArrow=none;fontSize=11;align=center;verticalAlign=bottom;" value="1. Клик по карточке ТС на дашборде">
          <mxGeometry relative="1" x="NaN" as="geometry">
            <mxPoint as="offset" />
            <mxPoint x="130" y="120" as="sourcePoint" />
            <mxPoint x="130" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="2. GET /vehicles/{id} — данные ТС и ссылки на фото">
          <mxGeometry relative="1" x="0.037" y="-20" as="geometry">
            <mxPoint as="offset" />
            <mxPoint x="130" y="139.9957142857143" as="sourcePoint" />
            <mxPoint x="400" y="139.9957142857143" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" edge="1" parent="1" style="html=1;endArrow=block;fontSize=11;align=center;verticalAlign=bottom;" value="3. Проксирует">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="188.99571428571434" as="sourcePoint" />
            <mxPoint x="670" y="188.99571428571434" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=10;align=center;verticalAlign=bottom;" value="4. 200 OK (без кнопки «Добавить фото» — клиент только просматривает)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="259.9957142857143" as="sourcePoint" />
            <mxPoint x="400" y="259.9957142857143" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=11;align=center;verticalAlign=bottom;" value="5. 200 OK — карточка ТС">
          <mxGeometry relative="1" x="0.037" as="geometry">
            <mxPoint as="offset" />
            <mxPoint x="400" y="329.9957142857143" as="sourcePoint" />
            <mxPoint x="130" y="329.9957142857143" as="targetPoint" />
