        </mxCell>
        <mxCell id="m_history" edge="1" parent="1" style="html=1;endArrow=block;fontSize=10;align=center;verticalAlign=bottom;" value="6. За историей — GET /orders?client_id=me&amp;vehicle_id={id} (→ Orders)">
