        </mxCell>
        <mxCell id="e23" edge="1" parent="1" source="uc_pay" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;fontSize=10;strokeColor=#666666;" target="uc_gen_certificate" value="«include»">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e24" edge="1" parent="1" source="uc_create_order" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;fontSize=10;strokeColor=#666666;" target="uc_photofix" value="«extend»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo_create_order" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;size=14;" value="Создать заказ&#10;&#10;1. Инженер сканирует/вводит номер ТС&#10;2. Система ищет ТС в Vehicle; если нет — создаёт карточку&#10;3. Инженер указывает клиента (или создаёт нового); для новой карточки ТС он же — владелец (owner_id)&#10;4. Создаётся заказ со статусом &quot;active&quot;&#10;5. Заказ появляется в списке &quot;Мои заказы&quot; клиента" vertex="1">
          <mxGeometry height="170" width="260" x="840" y="300" as="geometry" />
        </mxCell>
        <mxCell id="note_e1" edge="1" parent="1" source="uc_create_order" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#82b366;" target="algo_create_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo_photofix" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;size=14;" value="Сделать фотофиксацию&#10;&#10;1. Инженер открывает камеру из заказа/карточки ТС&#10;2. Делает снимок, видит превью&#10;3. Подтверждает — фото уходит в Vehicle (HTTP, не RabbitMQ)&#10;4. Фото появляется в галерее &quot;Фотофиксация&quot;&#10;5. Клиент видит фото в своём кабинете (только просмотр)" vertex="1">
          <mxGeometry height="170" width="260" x="1300" y="540" as="geometry" />
        </mxCell>
        <mxCell id="note_e2" edge="1" parent="1" source="uc_photofix" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#82b366;" target="algo_photofix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo_pay" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;size=14;" value="&lt;b&gt;Отметить заказ оплаченным (v3)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Клиент нажимает «Отметить оплаченным».&lt;br&gt;2. Orders сохраняет paid, paid_at и команду списания.&lt;br&gt;3. Веб получает 200. Повтор возвращает прежний paid_at.&lt;br&gt;4. Inventory списывает товар через RabbitMQ.&lt;br&gt;5. Выдача и запуск справки ждут успешного списания.&lt;br&gt;6. При нехватке товара инженер может повторить списание после пополнения. Статус paid сохраняется.&lt;br&gt;&lt;br&gt;ADR-043" vertex="1">
          <mxGeometry height="390" width="300" x="1270" y="52.5" as="geometry" />
        </mxCell>
        <mxCell id="note_e3" edge="1" parent="1" source="uc_pay" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#6c8ebf;" target="algo_pay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo_certificate" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;size=14;" value="&lt;b&gt;Сформировать справку&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. У оплаченного заказа подтверждено списание.&lt;br&gt;2. Orders ставит справку в очередь воркера.&lt;br&gt;3. Воркер собирает позиции с сохранёнными ценами и данные всех исполнителей.&lt;br&gt;4. Готовые PDF и снапшот сохраняются в certificates.&lt;br&gt;5. После трёх неудачных попыток клиент видит сообщение о поддержке.&lt;br&gt;&lt;br&gt;ADR-035, ADR-043" vertex="1">
          <mxGeometry height="380" width="280" x="890" y="830" as="geometry" />
        </mxCell>
        <mxCell id="note_e4" edge="1" parent="1" source="uc_gen_certificate" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#82b366;" target="algo_certificate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uc_book" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Записаться на сервис" vertex="1">
          <mxGeometry height="60" width="180" x="740" y="140" as="geometry" />
        </mxCell>
