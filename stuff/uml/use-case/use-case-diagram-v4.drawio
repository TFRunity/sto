        <mxCell id="e_client_add_vehicle" parent="1" source="actor_client" target="uc_add_vehicle" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#6c8ebf;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uc_claim" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="Взять заявку в работу" vertex="1">
          <mxGeometry x="130" y="385" width="180" height="60" as="geometry" />
