xPoint x="1258" y="186" /><mxPoint x="1258" y="790" /><mxPoint x="1250" y="790" /></Array></mxGeometry></mxCell><mxCell id="e30s" value="0..*" parent="e30" connectable="0" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e30t" value="0..1" parent="e30" connectable="0" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;━━ ассоциация внутри сервиса (FK в одной БД)&lt;br&gt;&lt;font color='#3c5a8a'&gt;━━ &lt;b&gt;синяя&lt;/b&gt; — ссылка между сервисами: uuid по соглашению, без FK (ADR-001, ADR-007)&lt;/font&gt;&lt;br&gt;◆━ композиция: часть живёт и умирает с целым&lt;br&gt;━▷ обобщение (наследование)&lt;br&gt;╌╌&amp;gt; зависимость: использует / шлёт асинхронную команду&lt;br&gt;┄┄ пунктир с точками — связь с несуществующим модулем (TODO)&lt;br&gt;&lt;font color='#888888'&gt;&lt;i&gt;серый курсив&lt;/i&gt;&lt;/font&gt; — пояснение из sequence/ADR, не часть модели&lt;br&gt;&lt;font color='#b85450'&gt;&lt;b&gt;⚠&lt;/b&gt;&lt;/font&gt; — открытый вопрос (TODO §4), см. внизу" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" parent="1" vertex="1"><mxGeometry x="2270" y="1420" width="410" height="210" as="geometry" /></mxCell><mxCell id="issues" value="&lt;b&gt;Принятые решения&lt;/b&gt; (08.10.2026)&lt;br&gt;• &lt;b&gt;Статусы заказа:&lt;/b&gt; requested → active → paid / cancelled; &lt;b&gt;paid — финал&lt;/b&gt;, статуса completed нет (ADR-021).&lt;br&gt;• &lt;b&gt;Этап работ&lt;/b&gt; (принят / в_работе / готов / выдан) — отдельное поле заказа, меняет инженер; «выдан» только при paid. Статуса у ТС нет (ADR-021).&lt;br&gt;• &lt;b&gt;Инженеры заказа:&lt;/b&gt; orders.engineer_id — ответственный (claim, ADR-017); order_engineers — все исполнители. Claim = UPDATE + INSERT в одной транзакции (ADR-020).&lt;br&gt;• &lt;b&gt;Роли:&lt;/b&gt; client (через /register) / engineer / director (вручную в БД); Gateway проверяет роль по эндпоинтам (ADR-019).&lt;br&gt;• &lt;b&gt;Владелец ТС:&lt;/b&gt; vehicles.owner_id (client, без FK); новый use case клиента «Добавить ТС»; инженер проставляет владельца при создании карточки.&lt;br&gt;• &lt;b&gt;Оплата&lt;/b&gt; — только клиент в вебе; в RN вместо кнопки индикатор «Ожидает оплаты клиентом».&lt;br&gt;• &lt;b&gt;Чат&lt;/b&gt; — по ADR-018: POST + WebSocket; клиент↔ответственный инженер (по заказу), директор↔инженер (постоянный), поддержка = клиент↔директор; прочитанность — bool на сообщении.&lt;br&gt;• &lt;b&gt;Справка:&lt;/b&gt; active → completed / failed (опечатка «created» убрана).&lt;br&gt;• &lt;b&gt;Use case:&lt;/b&gt; добавить «Взять заявку в работу» (инженер); убрать линию «Записаться → Оплатить», связать Клиент → «Оплатить заказ».&lt;br&gt;&lt;br&gt;&lt;font color='#b85450'&gt;&lt;b&gt;⚠ Открыто:&lt;/b&gt;&lt;/font&gt; модуль коммерческих операций (TODO §4) — платёж, шлюз, возврат денег. «Выручка» в отчётах пока = сумма paid-заказов." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1"><mxGeometry x="20" y="1840" width="1790" height="250" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>