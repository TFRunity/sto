metry"><mxPoint x="130" y="340" as="sourcePoint" /><mxPoint x="400" y="340" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" edge="1" parent="1" style="html=1;endArrow=block;fontSize=11;align=center;verticalAlign=bottom;" value="7. Проксирует"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="384" as="sourcePoint" /><mxPoint x="670" y="384" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;whiteSpace=nowrap;" value="8. UPDATE messages SET прочитано = true WHERE dialog_id=? AND author_id &lt;&gt; ?" vertex="1"><mxGeometry height="20" width="10" x="678" y="418" as="geometry" /></mxCell><mxCell id="m9" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=11;align=center;verticalAlign=bottom;" value="9. WS push: «прочитано»"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="472" as="sourcePoint" /><mxPoint x="940" y="472" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m10" edge="1" parent="1" style="html=1;endArrow=block;fontSize=11;align=center;verticalAlign=bottom;" value="10. POST /dialogs/{id}/messages (text)"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="526" as="sourcePoint" /><mxPoint x="400" y="526" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m11" edge="1" parent="1" style="html=1;endArrow=block;fontSize=11;align=center;verticalAlign=bottom;" value="11. Проксирует"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="570" as="sourcePoint" /><mxPoint x="670" y="570" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m12" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;whiteSpace=nowrap;" value="12. INSERT messages (прочитано = false)" vertex="1"><mxGeometry height="20" width="10" x="678" y="604" as="geometry" /></mxCell><mxCell id="m13" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;fontSize=11;align=center;verticalAlign=bottom;" value=