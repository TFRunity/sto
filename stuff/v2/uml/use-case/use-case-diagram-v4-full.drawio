        <mxCell id="e21" edge="1" parent="1" source="actor_director" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#d79b00;" target="uc_employee_stats">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" edge="1" parent="1" source="actor_director" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#d79b00;" target="uc_chat_director">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" edge="1" parent="1" source="uc_pay" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;fontSize=10;strokeColor=#666666;" target="uc_gen_certificate" value="«include»">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e24" edge="1" parent="1" source="uc_create_order" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;fontSize=10;strokeColor=#666666;" target="uc_photofix" value="«extend»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo_create_order" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;size=14;" value="Создать заказ&#10;&#10;1. Инженер сканирует/вводит номер ТС&#10;2. Система ищет ТС в Vehicle; если нет — создаёт карточку&#10;3. Инженер указывает клиента (или создаёт нового); для новой карточки ТС он же — владелец (owner_id)&#10;4. Создаётся заказ со статусом &quot;active&quot;&#10;5. Заказ появляется в списке &quot;Мои заказы&quot; клиента" vertex="1">
          <mxGeometry height="170" width="260" x="840" y="300" as="geometry" />
        </mxCell>
        <mxCell id="note_e1" edge="1" parent="1" source="uc_create_order" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#82b366;" target="algo_create_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo_photofix" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;size=14;" value="Сделать фотофиксацию&#10;&#10;1. Инженер открывает камеру из заказа/карточки ТС&#10;2. Делает снимок, видит превью&#10;3. Подтверждает — фото уходит в Vehicle (HTTP, не RabbitMQ)&#10;4. Фото появляется в галерее &quot;Фотофиксация&quot;&#10;5. Клиент видит фото в своём кабинете (только просмотр)" vertex="1">
          <mxGeometry height="170" width="260" x="1300" y="540" as="geometry" />
        </mxCell>
        <mxCell id="note_e2" edge="1" parent="1" source="uc_photofix" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#82b366;" target="algo_photofix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo_pay" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;size=14;" value="Оплатить заказ (сага)&#10;&#10;1. Клиент нажимает &quot;Оплатить&quot;, заказ → &quot;paid&quot;&#10;2. Orchestrator (Orders) публикует команду списания в Inventory через outbox+RabbitMQ&#10;3. Inventory: UPDATE quantity WHERE quantity &gt; 0 (атомарно), публикует реплай с результатом&#10;4. Orchestrator получает реплай и решает исход&#10;5. Успех → заказ остаётся &quot;paid&quot;, компенсация не нужна&#10;6. Неудача (&quot;failed&quot;) → компенсация: заказ → &quot;active&quot;, возврат денег — TODO (модуль коммерческих операций, не спроектирован)" vertex="1">
          <mxGeometry height="195" width="280" x="1270" y="52.5" as="geometry" />
        </mxCell>
        <mxCell id="note_e3" edge="1" parent="1" source="uc_pay" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#6c8ebf;" target="algo_pay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo_certificate" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;size=14;" value="Сформировать справку&#10;&#10;1. Доступно только после статуса &quot;paid&quot; (include от &quot;Оплатить заказ&quot;)&#10;2. Orders собирает данные по ссылкам: order_engineers (все исполнители) → Users, услуги/товары → Inventory/Services (текущие значения, не снапшот)&#10;3. chassis/certificate собирает PDF: статус &quot;active&quot; → &quot;completed&quot;/&quot;failed&quot;&#10;4. Собранные данные фиксируются как снапшот именно в таблице certificates (юридический документ, дальше неизменен)&#10;5. При &quot;failed&quot;: retry-воркер повторяет, счётчик +1, до 3 раз&#10;6. После 3 неудач: &quot;обратитесь в поддержку&quot;&#10;7. Успех (&quot;completed&quot;) — доступна в истории клиента" vertex="1">
          <mxGeometry height="260" width="280" x="890" y="830" as="geometry" />
        </mxCell>
        <mxCell id="note_e4" edge="1" parent="1" source="uc_gen_certificate" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#82b366;" target="algo_certificate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo_reports" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;size=14;" value="Сформировать отчёт&#10;&#10;1. Директор выбирает тип (выручка / по сотрудникам / по справкам-заказам) и период&#10;2. Reports создаёт запись в report_requests (&quot;pending&quot;)&#10;3. Публикует команду через outbox+RabbitMQ в Orders/Users&#10;4. Ответ асинхронный (отдельное событие, не ожидание)&#10;5. Получен → report_requests: &quot;received&quot;, данные — в reports_[тип] как снапшот&#10;6. Таймаут без ответа → retry (по аналогии с certificate: ограниченное число попыток), после исчерпания — &quot;failed&quot;" vertex="1">
          <mxGeometry height="200" width="280" x="830" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="note_e5" edge="1" parent="1" source="uc_reports" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#d79b00;" target="algo_reports">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
