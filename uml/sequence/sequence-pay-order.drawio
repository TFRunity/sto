        <mxCell id="frame14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=1;" value="loop: воркер дедлайнов Orders (тик ~1 с) — параллельно шагам 7–18" vertex="1">
          <mxGeometry x="40" y="1115" width="1520" height="235" as="geometry" />
        </mxCell>
