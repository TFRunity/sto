<mxfile host="Electron"><diagram name="Sequence - Писать в чат (клиент)" id="seq-chat-client"><mxGraphModel dx="975" dy="580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="664" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p_client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" value="Клиент (веб)" vertex="1"><mxGeometry height="40" width="140" x="60" y="40" as="geometry" /></mxCell><mxCell id="p_gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1efe8;strokeColor=#888780;fontSize=13;fontStyle=1;" value="API Gateway" vertex="1"><mxGeometry height="40" width="140" x="330" y="40" as="geometry" /></mxCell><mxCell id="p_chat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" value="Chat service" vertex="1"><mxGeometry height="40" width="140" x="600" y="40" as="geometry" /></mxCell><mxCell id="p_peer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" value="Инженер / Директор" vertex="1"><mxGeometry height="40" width="140" x="870" y="40" as="geometry" /></mxCell><mxCell id="ll1" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" value="" source="p_client"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="80" as="sourcePoint" /><mxPoint x="130" y="624" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll2" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" value="" source="p_gateway"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="80" as="sourcePoint" /><mxPoint x="400" y="624" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll3" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;" value="" source="p_chat"><mxGeometry relative="